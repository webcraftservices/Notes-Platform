# ============================================================================
# ENVIRONMENT VARIABLES — copy to .env.local and fill in real values.
# Never commit .env.local. This file only contains safe placeholders.
# ============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL with the pgvector extension enabled.
DATABASE_URL="postgresql://user:password@localhost:5432/knowledge_platform?schema=public"

# --- NextAuth ----------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Google OAuth (sign-in) --------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Drive / Docs (Connected Accounts, Phase 7) ----------------------
# Same OAuth client as above works if the Drive/Docs scopes are enabled on it;
# kept as separate names here so scopes can be split onto a different client later.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""

# --- Object storage, Phase 3 --------------------------------------------------
# STORAGE_PROVIDER selects the backend explicitly ("local" or "s3"). If unset,
# it's inferred: local by default, s3 if STORAGE_ENDPOINT/STORAGE_BUCKET are set.
# Local is a real, working backend for dev — files land on disk under
# STORAGE_LOCAL_DIR (default: ./.storage, already gitignored). Use it for
# local development with zero setup. Switch to s3 for anything deployed.
STORAGE_PROVIDER=""
STORAGE_LOCAL_DIR="./.storage"

# S3-compatible config (AWS S3, Cloudflare R2, Backblaze B2, MinIO, ...).
# STORAGE_ENDPOINT is only needed for non-AWS providers.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- AI providers, Phase 4/5 --------------------------------------------------
# At minimum one of these must be set for AI features (Phase 5) to activate.
# GOOGLE_AI_API_KEY is the one with a concrete implementation today — see
# AI_PROVIDER below.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""

# --- Speech-to-text, Phase 4 ---------------------------------------------------
# Real cloud transcription — no local model, by design (heavy STT belongs on
# a server with real compute, not the developer's laptop). Set exactly one:
#
#   SPEECH_PROVIDER=assemblyai  (recommended)
#     + ASSEMBLYAI_API_KEY — real speaker diarization, no practical file-size
#     limit (long lectures don't need client-side chunking). See
#     https://www.assemblyai.com/
#
#   SPEECH_PROVIDER=openai
#     + OPENAI_API_KEY — cheaper/simpler if you don't need speaker labels;
#     capped at 25MB per request (~a bit over an hour of compressed speech).
#
# Leave SPEECH_PROVIDER unset to leave transcription off — uploads and
# recordings still work, "Transcribe" just fails with a clear configuration
# error instead of silently pretending to work (see docs/ARCHITECTURE.md).
SPEECH_PROVIDER=""
ASSEMBLYAI_API_KEY=""

AI_PROVIDER="gemini"          # anthropic | openai | gemini — Phase 5
EMBEDDING_PROVIDER="openai"   # openai | google — Phase 5
# NOTE: as of Phase 5, AI_PROVIDER=gemini has a concrete implementation
# (src/lib/services/ai-gemini.ts, using GOOGLE_AI_API_KEY above) — chosen
# as the default provider specifically to keep initial operating cost as
# close to zero as possible (Gemini's Flash-Lite tier is free within rate
# limits; see that file's doc comment for the exact model and reasoning).
# "anthropic" and "openai" remain named, supported provider values with no
# concrete implementation yet — setting AI_PROVIDER to either of those only
# changes the ServiceNotConfiguredError message, same as before. Nothing
# is hard-coded to Gemini outside src/lib/services/ai.ts's registry branch.
#
# EMBEDDING_PROVIDER=openai has a concrete implementation
# (src/lib/services/embedding-openai.ts) — set it together with
# OPENAI_API_KEY above to activate real semantic indexing (EMBEDDING jobs).
# RAG search (AI chat, "Ask AI") needs BOTH a configured AIService *and*
# real embeddings to already exist for a material before it can answer
# questions grounded in that material.
#
# IMPORTANT — embedding dimension is fixed at 1536: MaterialChunk.embedding
# is a pgvector `vector(1536)` column, migrated in Phase 1 before any
# embedding provider was chosen. embedding-openai.ts uses OpenAI's
# text-embedding-3-small and explicitly requests 1536 dimensions (its
# default size, but requested explicitly rather than relied upon) — a
# different EmbeddingService cannot be dropped in as a registry swap if its
# natural output size differs; that requires a deliberate schema migration
# (change the column's dimension and re-embed every existing MaterialChunk).
# See docs/ai-setup.md.

# --- Rate limiting (production), Phase 9 -------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Misc ---------------------------------------------------------------------
NODE_ENV="development"
