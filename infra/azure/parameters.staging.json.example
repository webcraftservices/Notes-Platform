{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "staging" },
    "namePrefix": { "value": "zenote" },
    "acrName": { "value": "zenotestagingacr" },
    "webImage": { "value": "zenotestagingacr.azurecr.io/zenote-web:staging-latest" },
    "workerImage": { "value": "zenotestagingacr.azurecr.io/zenote-worker:staging-latest" },
    "migratorImage": { "value": "zenotestagingacr.azurecr.io/zenote-migrator:staging-latest" },
    "publicBaseUrl": { "value": "https://staging.zenote.app" },
    "storageEndpoint": { "value": "https://your-r2-account-id.r2.cloudflarestorage.com" },
    "storageBucket": { "value": "zenote-staging" },
    "storageRegion": { "value": "auto" },
    "googleCloudProject": { "value": "your-gcp-project-id" },
    "googleCloudLocation": { "value": "us-central1" },
    "googleWifAudience": { "value": "//iam.googleapis.com/projects/000000000000/locations/global/workloadIdentityPools/azure-aca-pool/providers/azure-entra" },
    "googleWifAzureResource": { "value": "api://AzureADTokenExchange" },
    "googleWifServiceAccount": { "value": "zenote-vertex-staging@your-gcp-project-id.iam.gserviceaccount.com" },
    "enableOpenAiSecret": { "value": true },
    "enableGeminiApiKeySecret": { "value": false },
    "enableAssemblyAiSecret": { "value": true },
    "enableGoogleOAuthSecrets": { "value": false },
    "enableGoogleDriveClientSecrets": { "value": false },
    "enableGoogleTokenEncryptionSecret": { "value": false },
    "enableGoogleWebhookSecret": { "value": false },
    "enableStripeBillingSecrets": { "value": false },
    "enableDatadogSecret": { "value": false },
    "ddSite": { "value": "datadoghq.com" },
    "allowedRedirectOrigins": { "value": "" },
    "googleDriveWebhookUrl": { "value": "https://staging.zenote.app/api/integrations/google/webhook" },
    "stripePriceIdStudent": { "value": "" },
    "stripePriceIdPro": { "value": "" },
    "stripePriceIdTeam": { "value": "" },
    "stripePriceIdInstitution": { "value": "" },
    "webMinReplicas": { "value": 1 },
    "webMaxReplicas": { "value": 2 },
    "workerMinReplicas": { "value": 1 },
    "workerMaxReplicas": { "value": 2 }
  }
}
